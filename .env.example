# Bright Data Scraper Studio. Required by everything that scrapes.
# https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=your-bright-data-api-key

# OpenAI. Required by scripts/onboard.py, classify_topics.py, brief.py, digest.py and the
# /api/check-source and /api/relevance endpoints. Without it, topic classification falls
# back to patterns rather than failing, and those two endpoints return 503.
OPENAI_API_KEY=your-openai-api-key

# Optional. Overrides the model used everywhere. Defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# Only needed by the deployed /api/add-source endpoint, which dispatches a GitHub Actions
# run to build a new collector. A fine-grained token scoped to this repository alone, with
# Contents: read/write and Actions: read/write. Set it in the Vercel project environment,
# not here.
# GITHUB_TOKEN=github_pat_...
